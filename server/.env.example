# Nyaya Flow Backend — Server-side secrets
# NEVER commit this file. It is in .gitignore.

# ──────────────────────────────────────────────────
# Google Gemini API Key (server-side only)
# ──────────────────────────────────────────────────
# Option A (RECOMMENDED for hackathon): Get a free API key from Google AI Studio:
#   → https://aistudio.google.com/app/apikey
#   Just sign in, click "Create API Key", and paste it below.
#
# Option B: Use your Firebase project's API key, but you MUST enable the
#   "Generative Language API" in your Google Cloud Console first:
#   → https://console.developers.google.com/apis/api/generativelanguage.googleapis.com/overview
#
GEMINI_API_KEY=

# YouTube Data API Key (server-side only)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Firebase project ID (for token verification)
FIREBASE_PROJECT_ID=nyaya-flow-india

# Port
PORT=3001
