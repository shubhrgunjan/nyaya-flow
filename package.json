{
  "name": "nyaya-flow",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "NODE_OPTIONS=\"-r ./scripts/node18-polyfill.js\" expo start",
    "android": "NODE_OPTIONS=\"-r ./scripts/node18-polyfill.js\" expo start --android",
    "ios": "NODE_OPTIONS=\"-r ./scripts/node18-polyfill.js\" expo start --ios",
    "web": "NODE_OPTIONS=\"-r ./scripts/node18-polyfill.js\" expo start --web",
    "build:web": "NODE_OPTIONS=\"-r ./scripts/node18-polyfill.js\" npx expo export -p web && touch dist/.nojekyll && cp dist/index.html dist/404.html",
    "deploy": "npm run build:web && npx gh-pages -d dist",
    "build:apk": "NODE_OPTIONS=\"-r ./scripts/node18-polyfill.js\" npx eas-cli build -p android --profile preview",
    "run:android": "NODE_OPTIONS=\"-r ./scripts/node18-polyfill.js\" expo run:android --variant release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src app __tests__",
    "test": "jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@google/genai": "^2.21.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-av": "^16.0.8",
    "expo-constants": "~57.0.11",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.6",
    "expo-font": "~57.0.4",
    "expo-image-picker": "^57.0.16",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.10",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "babel-preset-expo": "^57.0.10",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "private": true
}
