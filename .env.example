# Nyaya Flow Mobile Environment Configuration
# DO NOT COMMIT REAL SECRETS OR PROD API KEYS TO THIS REPOSITORY

# Mobile AI Backend Base URL (The mobile app connects to a secure backend API, not direct Gemini)
EXPO_PUBLIC_AI_BACKEND_URL=https://api.nyayaflow.in/v1

# Firebase Configuration Shell (Optional for local development)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nyaya-flow-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nyaya-flow-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nyaya-flow-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Environment flag (development, staging, production)
EXPO_PUBLIC_APP_ENV=development
