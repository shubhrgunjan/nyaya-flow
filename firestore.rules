rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: owner-only read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Case documents: owner-only read/write/delete
    match /cases/{caseId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      
      // Subcollections
      match /actions/{actionId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerUid == request.auth.uid;
      }
      match /documents/{documentId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerUid == request.auth.uid;
      }
      match /messages/{messageId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerUid == request.auth.uid;
      }
      match /deadlines/{deadlineId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/cases/$(caseId)).data.ownerUid == request.auth.uid;
      }
    }
    
    // Public legal knowledge & guides: read-only for authenticated/anonymous users
    match /legal_knowledge/{guideId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
