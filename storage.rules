rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User evidence documents: path must match owner UID
    match /users/{userId}/cases/{caseId}/documents/{documentId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
